<?xml version="1.0" encoding="utf-8"?>
<!-- White, flat Google search bar based on the reference image. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:contentDescription="@string/f03j_google_search_hint"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:background="@drawable/f03j_qsb_white_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="28dp"
            android:layout_marginLeft="16dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/f03j_qsb_google_logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginRight="8dp"
            android:contentDescription="@null"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/f03j_qsb_google_mic" />
    </LinearLayout>
</FrameLayout>
